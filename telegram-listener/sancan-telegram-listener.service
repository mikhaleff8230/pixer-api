[Unit]
Description=SANCAN Telegram Import Listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sancan/pixer-api/telegram-listener
EnvironmentFile=/etc/sancan/telegram-import.env
ExecStart=/var/www/sancan/telegram-listener-venv/bin/python listener.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sancan-telegram

[Install]
WantedBy=multi-user.target
